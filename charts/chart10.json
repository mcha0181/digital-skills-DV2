{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": 540,
  "height": 370,
  "config": {
    "background": "transparent",
    "font": "Arial",
    "axis": {
      "labelColor": "#334155",
      "titleColor": "#334155",
      "gridColor": "#e2e8f0"
    },
    "view": {
      "stroke": null
    }
  },
  "title": {
    "text": "MAP 3 · Choropleth: online Census response (2021)",
    "fontSize": 16,
    "anchor": "start"
  },
  "projection": {
    "type": "mercator"
  },
  "data": {
    "url": "https://raw.githubusercontent.com/rowanhogan/australian-states/master/states.min.geojson",
    "format": {
      "type": "json",
      "property": "features"
    }
  },
  "transform": [
    {
      "lookup": "properties.STATE_NAME",
      "from": {
        "data": {
          "url": "data/states_census_map.csv"
        },
        "key": "state",
        "fields": [
          "online2021",
          "code"
        ]
      }
    }
  ],
  "mark": {
    "type": "geoshape",
    "stroke": "white",
    "strokeWidth": 1.4
  },
  "encoding": {
    "color": {
      "field": "online2021",
      "type": "quantitative",
      "scale": {
        "scheme": "blues",
        "domain": [
          60,
          95
        ]
      },
      "title": "Online response (%)"
    },
    "tooltip": [
      {
        "field": "properties.STATE_NAME",
        "type": "nominal",
        "title": "State / territory"
      },
      {
        "field": "online2021",
        "type": "quantitative",
        "title": "Online response (%)",
        "format": ".1f"
      }
    ]
  }
}
