{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "ACT leads on ability; Tasmania trails",
    "subtitle": "Digital Ability Index, 2025 · approximate positions",
    "anchor": "start",
    "font": "Arial",
    "fontWeight": "normal",
    "fontSize": 17,
    "subtitleFontSize": 11,
    "subtitleColor": "#59696d",
    "color": "#263940",
    "offset": 14
  },
  "width": 640,
  "height": 400,
  "data": {
    "url": "data/states_2025.csv"
  },
  "config": {
    "background": "transparent",
    "font": "Arial",
    "view": {
      "stroke": null
    },
    "axis": {
      "domain": false,
      "ticks": false,
      "grid": false,
      "labels": false,
      "title": null,
      "labelColor": "#20343B",
      "titleColor": "#20343B",
      "gridColor": "#e5e9e5",
      "labelFontSize": 12,
      "titleFontSize": 12
    },
    "legend": {
      "labelColor": "#20343B",
      "titleColor": "#20343B",
      "labelFontSize": 12,
      "titleFontSize": 12
    }
  },
  "transform": [
    {
      "calculate": "datum.ability < 72 ? 'Below 72' : datum.ability < 76 ? '72–75.9' : '76 and above'",
      "as": "ability_band"
    }
  ],
  "layer": [
    {
      "mark": {
        "type": "circle",
        "size": 2500,
        "opacity": 0.95,
        "stroke": "#ffffff",
        "strokeWidth": 2
      },
      "encoding": {
        "x": {
          "field": "map_x",
          "type": "quantitative",
          "scale": {
            "domain": [
              0,
              9
            ],
            "nice": false
          }
        },
        "y": {
          "field": "map_y",
          "type": "quantitative",
          "scale": {
            "domain": [
              8,
              1
            ],
            "nice": false
          }
        },
        "color": {
          "field": "ability_band",
          "type": "nominal",
          "scale": {
            "domain": [
              "Below 72",
              "72–75.9",
              "76 and above"
            ],
            "range": [
              "#D55E00",
              "#7B9EAC",
              "#0072B2"
            ]
          },
          "legend": {
            "title": "Digital ability (0–100)",
            "orient": "bottom",
            "direction": "horizontal"
          }
        },
        "tooltip": [
          {
            "field": "state",
            "title": "State / territory"
          },
          {
            "field": "ability",
            "title": "Digital ability",
            "format": ".1f"
          },
          {
            "field": "ability_band",
            "title": "Score band"
          }
        ]
      }
    },
    {
      "mark": {
        "type": "text",
        "dy": -8,
        "fontSize": 13,
        "fontWeight": "bold",
        "color": "#16343d"
      },
      "encoding": {
        "x": {
          "field": "map_x",
          "type": "quantitative",
          "scale": {
            "domain": [
              0,
              9
            ],
            "nice": false
          }
        },
        "y": {
          "field": "map_y",
          "type": "quantitative",
          "scale": {
            "domain": [
              8,
              1
            ],
            "nice": false
          }
        },
        "text": {
          "field": "code"
        },
        "color": {
          "condition": {
            "test": "datum.ability_band === '76 and above'",
            "value": "#FFFFFF"
          },
          "value": "#20343B"
        }
      }
    },
    {
      "mark": {
        "type": "text",
        "dy": 10,
        "fontSize": 12,
        "color": "#16343d"
      },
      "encoding": {
        "x": {
          "field": "map_x",
          "type": "quantitative",
          "scale": {
            "domain": [
              0,
              9
            ],
            "nice": false
          }
        },
        "y": {
          "field": "map_y",
          "type": "quantitative",
          "scale": {
            "domain": [
              8,
              1
            ],
            "nice": false
          }
        },
        "text": {
          "field": "ability",
          "type": "quantitative",
          "format": ".1f"
        },
        "color": {
          "condition": {
            "test": "datum.ability_band === '76 and above'",
            "value": "#FFFFFF"
          },
          "value": "#20343B"
        }
      }
    }
  ]
}
