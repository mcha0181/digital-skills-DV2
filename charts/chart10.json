{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": 660,
  "height": 410,
  "config": {
    "background": "transparent",
    "font": "Arial",
    "view": {
      "stroke": null
    },
    "axis": {
      "labelColor": "#374b50",
      "titleColor": "#374b50",
      "gridColor": "#e9e8e1",
      "labelFontSize": 12,
      "titleFontSize": 12
    },
    "legend": {
      "labelColor": "#243746",
      "titleColor": "#243746",
      "labelFontSize": 12
    }
  },
  "title": {
    "text": "Where are digital ability scores higher?",
    "fontSize": 17,
    "anchor": "start",
    "color": "#21343a",
    "fontWeight": "normal",
    "subtitle": "2025 · three bands make state comparisons easier"
  },
  "projection": {
    "type": "mercator"
  },
  "data": {
    "url": "https://raw.githubusercontent.com/rowanhogan/australian-states/master/states.min.geojson",
    "format": {
      "type": "json",
      "property": "features"
    }
  },
  "transform": [
    {
      "lookup": "properties.STATE_NAME",
      "from": {
        "data": {
          "url": "data/states_2025.csv"
        },
        "key": "state",
        "fields": [
          "ability",
          "code"
        ]
      }
    },
    {
      "calculate": "isValid(datum.ability) ? (datum.ability < 72 ? 'Below 72' : datum.ability < 76 ? '72–75.9' : '76 and above') : 'No data'",
      "as": "ability_band"
    }
  ],
  "mark": {
    "type": "geoshape",
    "stroke": "#ffffff",
    "strokeWidth": 1.4
  },
  "encoding": {
    "color": {
      "field": "ability_band",
      "type": "nominal",
      "scale": {
        "domain": [
          "Below 72",
          "72–75.9",
          "76 and above",
          "No data"
        ],
        "range": [
          "#e8c9a8",
          "#8ebdb1",
          "#216f69",
          "#dddcd5"
        ]
      },
      "legend": {
        "title": "Digital ability (0–100)",
        "orient": "bottom",
        "direction": "horizontal"
      }
    },
    "tooltip": [
      {
        "field": "properties.STATE_NAME",
        "title": "State / territory"
      },
      {
        "field": "ability",
        "type": "quantitative",
        "format": ".1f",
        "title": "Digital ability"
      },
      {
        "field": "ability_band",
        "title": "Score band"
      }
    ]
  }
}
