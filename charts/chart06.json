{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "The ACT scores highest across all three measures",
    "subtitle": "2025 scores · index scale from 0 to 100",
    "anchor": "start",
    "font": "Arial",
    "fontWeight": "normal",
    "fontSize": 17,
    "subtitleFontSize": 11,
    "subtitleColor": "#59696d",
    "color": "#263940",
    "offset": 14
  },
  "width": "container",
  "height": 255,
  "data": {
    "url": "data/states_2025.csv"
  },
  "config": {
    "background": "transparent",
    "font": "Arial",
    "view": {
      "stroke": null
    },
    "axis": {
      "labelColor": "#20343B",
      "titleColor": "#20343B",
      "gridColor": "#e5e9e5",
      "labelFontSize": 12,
      "titleFontSize": 12
    },
    "legend": {
      "labelColor": "#20343B",
      "titleColor": "#20343B",
      "labelFontSize": 12,
      "titleFontSize": 12
    }
  },
  "transform": [
    {
      "fold": [
        "ability",
        "access",
        "affordability"
      ],
      "as": [
        "measure",
        "score"
      ]
    },
    {
      "calculate": "datum.measure === 'ability' ? 'Digital ability' : datum.measure === 'access' ? 'Access' : 'Affordability'",
      "as": "dimension"
    },
    {
      "calculate": "datum.code === 'ACT' ? 'ACT' : datum.code === 'TAS' ? 'TAS' : datum.code",
      "as": "state_code"
    }
  ],
  "layer": [
    {
      "mark": {
        "type": "rect",
        "stroke": "#ffffff",
        "strokeWidth": 2
      },
      "encoding": {
        "x": {
          "field": "code",
          "type": "nominal",
          "sort": [
            "ACT",
            "VIC",
            "NSW",
            "WA",
            "NT",
            "QLD",
            "SA",
            "TAS"
          ],
          "title": null,
          "axis": {
            "labelAngle": 0
          }
        },
        "y": {
          "field": "dimension",
          "type": "nominal",
          "sort": [
            "Digital ability",
            "Access",
            "Affordability"
          ],
          "title": null
        },
        "color": {
          "field": "score",
          "type": "quantitative",
          "scale": {
            "domain": [
              65,
              82
            ],
            "range": [
              "#F0F7FA",
              "#85BDD7",
              "#075985"
            ]
          },
          "legend": {
            "title": "Score (0–100)"
          }
        },
        "tooltip": [
          {
            "field": "state",
            "title": "State / territory"
          },
          {
            "field": "dimension"
          },
          {
            "field": "score",
            "format": ".1f"
          }
        ]
      }
    },
    {
      "mark": {
        "type": "text",
        "fontSize": 12,
        "color": "#153036"
      },
      "encoding": {
        "x": {
          "field": "code",
          "type": "nominal",
          "sort": [
            "ACT",
            "VIC",
            "NSW",
            "WA",
            "NT",
            "QLD",
            "SA",
            "TAS"
          ]
        },
        "y": {
          "field": "dimension",
          "type": "nominal",
          "sort": [
            "Digital ability",
            "Access",
            "Affordability"
          ]
        },
        "text": {
          "field": "score",
          "type": "quantitative",
          "format": ".1f"
        },
        "color": {
          "condition": {
            "test": "datum.score >= 75",
            "value": "#FFFFFF"
          },
          "value": "#20343B"
        }
      }
    }
  ]
}
