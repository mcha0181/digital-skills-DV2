{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": "container",
  "height": 300,
  "config": {
    "background": "transparent",
    "font": "Arial",
    "axis": {
      "labelColor": "#334155",
      "titleColor": "#334155",
      "gridColor": "#e2e8f0"
    },
    "view": {
      "stroke": null
    }
  },
  "title": {
    "text": "Digital ability varies across states (2025)",
    "fontSize": 16,
    "anchor": "start",
    "color": "#172554"
  },
  "data": {
    "url": "data/states_2025.csv"
  },
  "mark": {
    "type": "bar",
    "color": "#2563eb"
  },
  "encoding": {
    "y": {
      "field": "code",
      "type": "nominal",
      "sort": "-x",
      "title": null
    },
    "x": {
      "field": "ability",
      "type": "quantitative",
      "title": "Digital Ability score (0–100)",
      "scale": {
        "domain": [
          0,
          100
        ]
      }
    },
    "tooltip": [
      {
        "field": "state",
        "type": "nominal"
      },
      {
        "field": "ability",
        "type": "quantitative"
      }
    ]
  }
}