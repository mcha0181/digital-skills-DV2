{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": "container",
  "config": {
    "background": "transparent",
    "font": "Arial",
    "view": {
      "stroke": null
    },
    "axis": {
      "labelColor": "#20343B",
      "titleColor": "#20343B",
      "gridColor": "#e5e9e5",
      "labelFontSize": 12
    },
    "legend": {
      "labelColor": "#20343B",
      "titleColor": "#20343B"
    }
  },
  "title": {
    "text": "ACT leads; Tasmania trails",
    "subtitle": "Digital Ability Index, 2025 · scores out of 100",
    "anchor": "start",
    "fontSize": 17,
    "fontWeight": "normal",
    "color": "#263940",
    "subtitleColor": "#59696d"
  },
  "height": 290,
  "data": {
    "url": "data/states_2025.csv"
  },
  "mark": {
    "type": "bar",
    "size": 19,
    "cornerRadiusEnd": 3
  },
  "encoding": {
    "y": {
      "field": "code",
      "type": "nominal",
      "sort": {
        "field": "ability",
        "order": "descending"
      },
      "title": null
    },
    "x": {
      "field": "ability",
      "type": "quantitative",
      "scale": {
        "domain": [
          0,
          100
        ]
      },
      "title": "Digital ability score (0–100)"
    },
    "color": {
      "condition": {
        "test": "datum.code === 'ACT'",
        "value": "#0072B2"
      },
      "value": "#8CA0A5"
    },
    "tooltip": [
      {
        "field": "state",
        "type": "nominal"
      },
      {
        "field": "ability",
        "type": "quantitative",
        "format": ".1f"
      }
    ]
  }
}
