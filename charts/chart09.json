{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "Where did people respond to the Census online?",
    "fontSize": 17,
    "fontWeight": "normal",
    "anchor": "start",
    "color": "#21343a",
    "offset": 16,
    "subtitle": "2021 · circle area shows response percentage"
  },
  "width": 660,
  "height": 405,
  "config": {
    "background": "transparent",
    "font": "Arial",
    "view": {
      "stroke": null
    },
    "axis": {
      "labelColor": "#374b50",
      "titleColor": "#374b50",
      "gridColor": "#e9e8e1",
      "labelFontSize": 12,
      "titleFontSize": 12
    },
    "legend": {
      "labelColor": "#243746",
      "titleColor": "#243746",
      "labelFontSize": 12
    }
  },
  "projection": {
    "type": "mercator",
    "center": [
      134,
      -27
    ],
    "scale": 710
  },
  "layer": [
    {
      "data": {
        "url": "https://cdn.jsdelivr.net/npm/vega-datasets@2/data/world-110m.json",
        "format": {
          "type": "topojson",
          "feature": "countries"
        }
      },
      "transform": [
        {
          "filter": "datum.id == 36"
        }
      ],
      "mark": {
        "type": "geoshape",
        "fill": "#e7eae5",
        "stroke": "#8e9b9a",
        "strokeWidth": 1
      }
    },
    {
      "data": {
        "url": "data/states_census_map.csv"
      },
      "mark": {
        "type": "circle",
        "color": "#237c76",
        "stroke": "#fff",
        "strokeWidth": 2,
        "opacity": 0.84
      },
      "encoding": {
        "longitude": {
          "field": "lon",
          "type": "quantitative"
        },
        "latitude": {
          "field": "lat",
          "type": "quantitative"
        },
        "size": {
          "field": "online2021",
          "type": "quantitative",
          "scale": {
            "domain": [
              0,
              100
            ],
            "range": [
              0,
              3900
            ]
          },
          "legend": {
            "title": "Online Census response (%)",
            "values": [
              25,
              50,
              75,
              100
            ],
            "orient": "bottom",
            "symbolFillColor": "#237c76"
          }
        },
        "tooltip": [
          {
            "field": "state",
            "title": "State / territory"
          },
          {
            "field": "online2021",
            "type": "quantitative",
            "title": "Responded online (%)",
            "format": ".1f"
          }
        ]
      }
    }
  ]
}
