{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "Online Census participation varies by state",
    "subtitle": "2021 online Census response (%) · approximate positions",
    "anchor": "start",
    "font": "Arial",
    "fontWeight": "normal",
    "fontSize": 17,
    "subtitleFontSize": 11,
    "subtitleColor": "#59696d",
    "color": "#263940",
    "offset": 14
  },
  "width": 640,
  "height": 400,
  "data": {
    "url": "data/states_census_map.csv"
  },
  "config": {
    "background": "transparent",
    "font": "Arial",
    "view": {
      "stroke": null
    },
    "axis": {
      "domain": false,
      "ticks": false,
      "grid": false,
      "labels": false,
      "title": null,
      "labelColor": "#20343B",
      "titleColor": "#20343B",
      "gridColor": "#e5e9e5",
      "labelFontSize": 12,
      "titleFontSize": 12
    },
    "legend": {
      "labelColor": "#20343B",
      "titleColor": "#20343B",
      "labelFontSize": 12,
      "titleFontSize": 12
    }
  },
  "transform": [
    {
      "calculate": "datum.online2021 >= 80 ? '80% or more' : datum.online2021 >= 70 ? '70–79.9%' : 'Below 70%'",
      "as": "band"
    }
  ],
  "layer": [
    {
      "mark": {
        "type": "circle",
        "opacity": 0.9,
        "stroke": "#ffffff",
        "strokeWidth": 2
      },
      "encoding": {
        "x": {
          "field": "map_x",
          "type": "quantitative",
          "scale": {
            "domain": [
              0,
              9
            ],
            "nice": false
          }
        },
        "y": {
          "field": "map_y",
          "type": "quantitative",
          "scale": {
            "domain": [
              8,
              1
            ],
            "nice": false
          }
        },
        "size": {
          "field": "online2021",
          "type": "quantitative",
          "scale": {
            "domain": [
              60,
              95
            ],
            "range": [
              1200,
              3600
            ]
          },
          "legend": {
            "title": "Returned online (%)",
            "values": [
              60,
              75,
              90
            ],
            "orient": "bottom",
            "direction": "horizontal"
          }
        },
        "color": {
          "field": "band",
          "type": "nominal",
          "scale": {
            "domain": [
              "Below 70%",
              "70–79.9%",
              "80% or more"
            ],
            "range": [
              "#D55E00",
              "#88419D",
              "#0072B2"
            ]
          },
          "legend": {
            "title": "Online response band",
            "orient": "bottom",
            "direction": "horizontal"
          }
        },
        "tooltip": [
          {
            "field": "state",
            "title": "State / territory"
          },
          {
            "field": "online2021",
            "title": "Returned online (%)",
            "format": ".1f"
          }
        ]
      }
    },
    {
      "mark": {
        "type": "text",
        "dy": -8,
        "fontSize": 13,
        "fontWeight": "bold",
        "color": "#16343d"
      },
      "encoding": {
        "x": {
          "field": "map_x",
          "type": "quantitative",
          "scale": {
            "domain": [
              0,
              9
            ],
            "nice": false
          }
        },
        "y": {
          "field": "map_y",
          "type": "quantitative",
          "scale": {
            "domain": [
              8,
              1
            ],
            "nice": false
          }
        },
        "text": {
          "field": "code"
        },
        "color": {
          "value": "#20343B"
        }
      }
    },
    {
      "mark": {
        "type": "text",
        "dy": 10,
        "fontSize": 12,
        "color": "#16343d"
      },
      "encoding": {
        "x": {
          "field": "map_x",
          "type": "quantitative",
          "scale": {
            "domain": [
              0,
              9
            ],
            "nice": false
          }
        },
        "y": {
          "field": "map_y",
          "type": "quantitative",
          "scale": {
            "domain": [
              8,
              1
            ],
            "nice": false
          }
        },
        "text": {
          "field": "online2021",
          "type": "quantitative",
          "format": ".1f"
        },
        "color": {
          "value": "#20343B"
        }
      }
    }
  ]
}
