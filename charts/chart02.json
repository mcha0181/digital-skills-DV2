{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": "container",
  "height": 300,
  "config": {
    "background": "transparent",
    "font": "Arial",
    "axis": {
      "labelColor": "#334155",
      "titleColor": "#334155",
      "gridColor": "#e2e8f0"
    },
    "view": {
      "stroke": null
    }
  },
  "title": {
    "text": "Australia and older adults gained digital skills",
    "fontSize": 16,
    "anchor": "start",
    "color": "#172554"
  },
  "data": {
    "url": "data/skills_time.csv"
  },
  "mark": {
    "type": "line",
    "point": true,
    "strokeWidth": 3
  },
  "encoding": {
    "x": {
      "field": "year",
      "type": "ordinal",
      "title": "Year"
    },
    "y": {
      "field": "score",
      "type": "quantitative",
      "title": "Digital Ability score",
      "scale": {
        "domain": [
          0,
          100
        ]
      }
    },
    "color": {
      "field": "group",
      "type": "nominal",
      "title": "Group"
    },
    "tooltip": [
      {
        "field": "group"
      },
      {
        "field": "year"
      },
      {
        "field": "score",
        "type": "quantitative"
      }
    ]
  },
  "transform": [
    {
      "filter": "datum.metric === \"Digital Ability\" && datum.group !== \"Did not complete secondary school\""
    }
  ]
}