{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "Older Australians are catching up",
    "subtitle": "Digital Ability Index, 2023 and 2025",
    "anchor": "start",
    "font": "Arial",
    "fontWeight": "normal",
    "fontSize": 17,
    "subtitleFontSize": 11,
    "subtitleColor": "#59696d",
    "color": "#263940",
    "offset": 14
  },
  "width": "container",
  "height": 275,
  "data": {
    "url": "data/skills_time.csv"
  },
  "config": {
    "background": "transparent",
    "font": "Arial",
    "view": {
      "stroke": null
    },
    "axis": {
      "labelColor": "#20343B",
      "titleColor": "#20343B",
      "gridColor": "#e5e9e5",
      "labelFontSize": 12,
      "titleFontSize": 12
    },
    "legend": {
      "labelColor": "#20343B",
      "titleColor": "#20343B",
      "labelFontSize": 12,
      "titleFontSize": 12
    }
  },
  "transform": [
    {
      "filter": "datum.metric === \"Digital Ability\" && (datum.group === \"Australia\" || datum.group === \"75+ years\")"
    }
  ],
  "layer": [
    {
      "mark": {
        "type": "line",
        "strokeWidth": 4,
        "point": {
          "filled": true,
          "size": 100
        }
      },
      "encoding": {
        "x": {
          "field": "year",
          "type": "ordinal",
          "axis": {
            "labelAngle": 0
          },
          "title": null
        },
        "y": {
          "field": "score",
          "type": "quantitative",
          "scale": {
            "domain": [
              0,
              100
            ]
          },
          "title": "Digital ability score"
        },
        "color": {
          "field": "group",
          "type": "nominal",
          "scale": {
            "domain": [
              "Australia",
              "75+ years"
            ],
            "range": [
              "#087f72",
              "#d26a3a"
            ]
          },
          "legend": {
            "orient": "bottom"
          }
        },
        "tooltip": [
          {
            "field": "group"
          },
          {
            "field": "year"
          },
          {
            "field": "score",
            "format": ".1f"
          }
        ]
      }
    },
    {
      "transform": [
        {
          "filter": "datum.year === 2025"
        }
      ],
      "mark": {
        "type": "text",
        "dx": 10,
        "align": "left",
        "fontWeight": "bold"
      },
      "encoding": {
        "x": {
          "field": "year",
          "type": "ordinal"
        },
        "y": {
          "field": "score",
          "type": "quantitative"
        },
        "text": {
          "field": "score",
          "format": ".1f",
          "type": "quantitative"
        },
        "color": {
          "field": "group",
          "scale": {
            "domain": [
              "Australia",
              "75+ years"
            ],
            "range": [
              "#087f72",
              "#d26a3a"
            ]
          },
          "legend": null,
          "type": "nominal"
        }
      }
    }
  ]
}
