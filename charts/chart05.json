{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": "container",
  "height": 300,
  "config": {
    "background": "transparent",
    "font": "Arial",
    "axis": {
      "labelColor": "#334155",
      "titleColor": "#334155",
      "gridColor": "#e2e8f0"
    },
    "view": {
      "stroke": null
    }
  },
  "title": {
    "text": "Key gaps in digital ability (2025)",
    "fontSize": 16,
    "anchor": "start",
    "color": "#172554"
  },
  "data": {
    "url": "data/ability_gaps.csv"
  },
  "mark": {
    "type": "bar",
    "color": "#e87937"
  },
  "encoding": {
    "y": {
      "field": "comparison",
      "type": "nominal",
      "sort": "-x",
      "title": null
    },
    "x": {
      "field": "gap",
      "type": "quantitative",
      "title": "Difference in index points"
    },
    "tooltip": [
      {
        "field": "comparison"
      },
      {
        "field": "gap",
        "type": "quantitative"
      }
    ]
  }
}