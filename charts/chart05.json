{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "The biggest divides are not geographic",
    "fontSize": 17,
    "fontWeight": "normal",
    "anchor": "start",
    "color": "#21343a",
    "offset": 16
  },
  "width": "container",
  "height": 270,
  "data": {
    "url": "data/ability_gaps.csv"
  },
  "config": {
    "background": "transparent",
    "font": "Arial",
    "view": {
      "stroke": null
    },
    "axis": {
      "labelColor": "#374b50",
      "titleColor": "#374b50",
      "gridColor": "#e9e8e1",
      "labelFontSize": 12,
      "titleFontSize": 12
    },
    "legend": {
      "labelColor": "#243746",
      "titleColor": "#243746",
      "labelFontSize": 12
    }
  },
  "layer": [
    {
      "mark": {
        "type": "rule",
        "strokeWidth": 3,
        "color": "#e2e7e4"
      },
      "encoding": {
        "y": {
          "field": "comparison",
          "type": "nominal",
          "sort": "-x",
          "title": null
        },
        "x": {
          "datum": 0
        },
        "x2": {
          "field": "gap"
        }
      }
    },
    {
      "mark": {
        "type": "point",
        "size": 180,
        "filled": true,
        "color": "#d26a3a"
      },
      "encoding": {
        "y": {
          "field": "comparison",
          "type": "nominal",
          "sort": "-x",
          "title": null
        },
        "x": {
          "field": "gap",
          "type": "quantitative",
          "scale": {
            "domain": [
              0,
              55
            ]
          },
          "title": "Difference (index points)"
        },
        "tooltip": [
          {
            "field": "comparison"
          },
          {
            "field": "gap",
            "format": ".1f"
          }
        ]
      }
    },
    {
      "mark": {
        "type": "text",
        "dx": 13,
        "fontWeight": "bold",
        "align": "left"
      },
      "encoding": {
        "y": {
          "field": "comparison",
          "type": "nominal",
          "sort": "-x"
        },
        "x": {
          "field": "gap",
          "type": "quantitative"
        },
        "text": {
          "field": "gap",
          "format": ".1f"
        }
      }
    }
  ]
}
