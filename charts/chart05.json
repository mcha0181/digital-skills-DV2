{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": "container",
  "config": {
    "background": "transparent",
    "font": "Arial",
    "view": {
      "stroke": null
    },
    "axis": {
      "labelColor": "#20343B",
      "titleColor": "#20343B",
      "gridColor": "#e5e9e5",
      "labelFontSize": 12
    },
    "legend": {
      "labelColor": "#20343B",
      "titleColor": "#20343B"
    }
  },
  "title": {
    "text": "Age is the largest reported gap",
    "subtitle": "Differences between groups · index points, not percentages",
    "anchor": "start",
    "fontSize": 17,
    "fontWeight": "normal",
    "color": "#263940",
    "subtitleColor": "#59696d"
  },
  "height": 240,
  "data": {
    "url": "data/ability_gaps.csv"
  },
  "mark": {
    "type": "bar",
    "size": 24,
    "cornerRadiusEnd": 3
  },
  "encoding": {
    "y": {
      "field": "comparison",
      "type": "nominal",
      "sort": {
        "field": "gap",
        "order": "descending"
      },
      "title": null,
      "axis": {
        "labelLimit": 270
      }
    },
    "x": {
      "field": "gap",
      "type": "quantitative",
      "scale": {
        "domain": [
          0,
          55
        ]
      },
      "title": "Difference (index points)"
    },
    "color": {
      "value": "#D55E00"
    },
    "tooltip": [
      {
        "field": "comparison",
        "type": "nominal"
      },
      {
        "field": "gap",
        "type": "quantitative",
        "format": ".1f"
      }
    ]
  }
}
