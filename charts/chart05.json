{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "Age and education show the biggest gaps",
    "subtitle": "Group differences in index points",
    "anchor": "start",
    "font": "Arial",
    "fontWeight": "normal",
    "fontSize": 17,
    "subtitleFontSize": 11,
    "subtitleColor": "#59696d",
    "color": "#263940",
    "offset": 14
  },
  "width": "container",
  "height": 270,
  "data": {
    "url": "data/ability_gaps.csv"
  },
  "config": {
    "background": "transparent",
    "font": "Arial",
    "view": {
      "stroke": null
    },
    "axis": {
      "labelColor": "#20343B",
      "titleColor": "#20343B",
      "gridColor": "#e5e9e5",
      "labelFontSize": 12,
      "titleFontSize": 12
    },
    "legend": {
      "labelColor": "#20343B",
      "titleColor": "#20343B",
      "labelFontSize": 12,
      "titleFontSize": 12
    }
  },
  "layer": [
    {
      "mark": {
        "type": "rule",
        "strokeWidth": 3,
        "color": "#e2e7e4"
      },
      "encoding": {
        "y": {
          "field": "comparison",
          "type": "nominal",
          "sort": "-x",
          "title": null
        },
        "x": {
          "datum": 0
        },
        "x2": {
          "field": "gap"
        }
      }
    },
    {
      "mark": {
        "type": "point",
        "size": 180,
        "filled": true,
        "color": "#D55E00"
      },
      "encoding": {
        "y": {
          "field": "comparison",
          "type": "nominal",
          "sort": "-x",
          "title": null
        },
        "x": {
          "field": "gap",
          "type": "quantitative",
          "scale": {
            "domain": [
              0,
              55
            ]
          },
          "title": "Difference (index points)"
        },
        "tooltip": [
          {
            "field": "comparison"
          },
          {
            "field": "gap",
            "format": ".1f"
          }
        ]
      }
    },
    {
      "mark": {
        "type": "text",
        "dx": 13,
        "fontWeight": "bold",
        "align": "left"
      },
      "encoding": {
        "y": {
          "field": "comparison",
          "type": "nominal",
          "sort": "-x"
        },
        "x": {
          "field": "gap",
          "type": "quantitative"
        },
        "text": {
          "field": "gap",
          "format": ".1f"
        }
      }
    }
  ]
}
