{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": 430,
  "height": 400,
  "config": {
    "background": "transparent",
    "font": "Arial",
    "axis": {
      "labelColor": "#334155",
      "titleColor": "#334155",
      "gridColor": "#e2e8f0"
    },
    "view": {
      "stroke": null
    }
  },
  "title": {
    "text": "MAP 1 \u00b7 Tile-grid cartogram of digital ability",
    "fontSize": 16,
    "anchor": "start",
    "color": "#172554"
  },
  "data": {
    "url": "data/states_2025.csv"
  },
  "layer": [
    {
      "mark": {
        "type": "rect",
        "cornerRadius": 6,
        "stroke": "#fff",
        "strokeWidth": 2
      },
      "encoding": {
        "x": {
          "field": "tile_x",
          "type": "ordinal",
          "axis": null
        },
        "y": {
          "field": "tile_y",
          "type": "ordinal",
          "axis": null,
          "sort": "descending"
        },
        "color": {
          "field": "ability",
          "type": "quantitative",
          "scale": {
            "scheme": "blues",
            "domain": [
              65,
              82
            ]
          },
          "title": "Score"
        },
        "tooltip": [
          {
            "field": "state"
          },
          {
            "field": "ability",
            "type": "quantitative"
          }
        ]
      }
    },
    {
      "mark": {
        "type": "text",
        "fontWeight": "bold",
        "color": "#0f172a"
      },
      "encoding": {
        "x": {
          "field": "tile_x",
          "type": "ordinal",
          "axis": null
        },
        "y": {
          "field": "tile_y",
          "type": "ordinal",
          "axis": null,
          "sort": "descending"
        },
        "text": {
          "field": "code",
          "type": "nominal"
        }
      }
    }
  ]
}