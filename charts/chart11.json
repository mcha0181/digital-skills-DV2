{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "Digital exclusion is not shared equally",
    "subtitle": "Excluded or highly excluded (%) · 2025",
    "anchor": "start",
    "font": "Arial",
    "fontWeight": "normal",
    "fontSize": 17,
    "subtitleFontSize": 11,
    "subtitleColor": "#59696d",
    "color": "#263940",
    "offset": 14
  },
  "data": {
    "url": "data/digital_exclusion_2025.csv"
  },
  "width": "container",
  "height": 210,
  "layer": [
    {
      "mark": {
        "type": "bar",
        "size": 24,
        "cornerRadiusEnd": 3
      },
      "encoding": {
        "y": {
          "field": "group",
          "type": "nominal",
          "sort": {
            "field": "order",
            "order": "ascending"
          },
          "title": null,
          "axis": {
            "labelLimit": 290,
            "labelFontSize": 12
          }
        },
        "x": {
          "field": "excluded_pct",
          "type": "quantitative",
          "title": "People digitally excluded (%)",
          "scale": {
            "domain": [
              0,
              75
            ]
          },
          "axis": {
            "grid": true,
            "tickCount": 5
          }
        },
        "color": {
          "condition": {
            "test": "datum.group === 'Australia overall'",
            "value": "#aebbb8"
          },
          "value": "#D55E00"
        },
        "tooltip": [
          {
            "field": "group",
            "title": "Group"
          },
          {
            "field": "excluded_pct",
            "type": "quantitative",
            "title": "Excluded (%)",
            "format": ".1f"
          }
        ]
      }
    },
    {
      "mark": {
        "type": "text",
        "align": "left",
        "dx": 7,
        "fontSize": 13,
        "fontWeight": "bold",
        "color": "#263940"
      },
      "encoding": {
        "y": {
          "field": "group",
          "type": "nominal",
          "sort": {
            "field": "order",
            "order": "ascending"
          }
        },
        "x": {
          "field": "excluded_pct",
          "type": "quantitative"
        },
        "text": {
          "field": "excluded_pct",
          "type": "quantitative",
          "format": ".1f"
        }
      }
    }
  ],
  "config": {
    "background": "transparent",
    "view": {
      "stroke": null
    },
    "font": "Arial",
    "axis": {
      "gridColor": "#e5e9e5",
      "labelColor": "#20343B",
      "titleColor": "#20343B",
      "labelFontSize": 12,
      "titleFontSize": 12
    },
    "legend": {
      "labelColor": "#20343B",
      "titleColor": "#20343B",
      "labelFontSize": 12,
      "titleFontSize": 12
    }
  }
}
