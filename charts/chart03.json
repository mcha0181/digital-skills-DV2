{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": "container",
  "config": {
    "background": "transparent",
    "font": "Arial",
    "view": {
      "stroke": null
    },
    "axis": {
      "labelColor": "#20343B",
      "titleColor": "#20343B",
      "gridColor": "#e5e9e5",
      "labelFontSize": 12
    },
    "legend": {
      "labelColor": "#20343B",
      "titleColor": "#20343B"
    }
  },
  "title": {
    "text": "The age gap is 47.4 points",
    "subtitle": "Adults aged 18–34 versus people aged 75+, 2025",
    "anchor": "start",
    "fontSize": 17,
    "fontWeight": "normal",
    "color": "#263940",
    "subtitleColor": "#59696d"
  },
  "height": 130,
  "data": {
    "url": "data/group_comparison.csv"
  },
  "mark": {
    "type": "bar",
    "size": 32,
    "cornerRadiusEnd": 3
  },
  "encoding": {
    "y": {
      "field": "group",
      "type": "nominal",
      "sort": [
        "18–34 years",
        "75+ years"
      ],
      "title": null,
      "axis": {
        "labelLimit": 190
      }
    },
    "x": {
      "field": "score",
      "type": "quantitative",
      "scale": {
        "domain": [
          0,
          100
        ]
      },
      "title": "Digital ability score (0–100)"
    },
    "color": {
      "condition": {
        "test": "datum.group === '75+ years'",
        "value": "#D55E00"
      },
      "value": "#0072B2"
    },
    "tooltip": [
      {
        "field": "group",
        "type": "nominal"
      },
      {
        "field": "score",
        "type": "quantitative",
        "format": ".1f"
      },
      {
        "field": "note",
        "type": "nominal"
      }
    ]
  },
  "transform": [
    {
      "filter": "datum.group === '18–34 years' || datum.group === '75+ years'"
    }
  ]
}
