{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "Education and digital ability go together",
    "subtitle": "Digital Ability Index by education, 2025",
    "anchor": "start",
    "font": "Arial",
    "fontWeight": "normal",
    "fontSize": 17,
    "subtitleFontSize": 11,
    "subtitleColor": "#59696d",
    "color": "#263940",
    "offset": 14
  },
  "width": "container",
  "height": 170,
  "data": {
    "url": "data/group_comparison.csv"
  },
  "config": {
    "background": "transparent",
    "font": "Arial",
    "view": {
      "stroke": null
    },
    "axis": {
      "labelColor": "#20343B",
      "titleColor": "#20343B",
      "gridColor": "#e5e9e5",
      "labelFontSize": 12,
      "titleFontSize": 12
    },
    "legend": {
      "labelColor": "#20343B",
      "titleColor": "#20343B",
      "labelFontSize": 12,
      "titleFontSize": 12
    }
  },
  "transform": [
    {
      "filter": "datum.group === \"University qualification\" || datum.group === \"Did not complete secondary school\""
    }
  ],
  "mark": {
    "type": "circle",
    "size": 320
  },
  "encoding": {
    "x": {
      "field": "score",
      "type": "quantitative",
      "scale": {
        "domain": [
          0,
          100
        ]
      },
      "title": "Digital ability score"
    },
    "y": {
      "field": "group",
      "type": "nominal",
      "sort": [
        "University qualification",
        "Did not complete secondary school"
      ],
      "title": null
    },
    "color": {
      "condition": {
        "test": "datum.group === \"University qualification\"",
        "value": "#0072B2"
      },
      "value": "#D55E00"
    },
    "tooltip": [
      {
        "field": "group"
      },
      {
        "field": "score",
        "format": ".1f"
      },
      {
        "field": "note"
      }
    ]
  }
}
